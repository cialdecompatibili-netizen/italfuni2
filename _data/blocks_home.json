        "id": "hero",
        "nome": "Hero",
        "enabled": true,
        "html": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link href=\"https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n#main-content{--ink:#15191d;--line:#dfe3d6;--warm:#fbf7e9;--muted:#4b4a44;--y:#efbb20;--gd:#8a6400;--deep:#3d2c00;--d:'Archivo Narrow','Arial Narrow',sans-serif;--ease:cubic-bezier(.16,1,.3,1)}\n#main-content ::selection{background:#efbb20;color:#15191d}\n.ex-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:.8rem 1.6rem;font-family:var(--d);font-weight:700;font-size:1.05rem;border-radius:2px;text-decoration:none;border:1px solid transparent;transition:background-color .2s var(--ease),border-color .2s var(--ease)}\n.ex-btn:focus-visible{outline:3px solid var(--ink);outline-offset:3px}.ex-end .ex-btn:focus-visible{outline-color:var(--y)}\n.ex-btn-y{background:var(--y);color:var(--ink)}.ex-btn-y:hover{background:#f7cb45}\n.ex-btn-o{border-color:#8b9580;color:var(--ink)}.ex-btn-o:hover{border-color:var(--ink)}\n.ex-btn-k{background:var(--ink);color:#fff}.ex-btn-k:hover{background:#2a323a}\n.ex-band .ex-btn:focus-visible{outline-color:var(--ink)}\n.ex-hero{background:#eef3e4;color:var(--ink);box-sizing:border-box;display:flex;align-items:center;min-height:calc(100vh - var(--mh,80px));min-height:calc(100svh - var(--mh,80px));padding:clamp(1.5rem,4vh,4rem) 1.5rem}\n.ex-hero-in{width:100%;max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1.2fr 1fr;gap:clamp(2rem,5vw,4.5rem);align-items:center}\n.ex-hero h1{font-family:var(--d);font-weight:700;font-size:clamp(2.1rem,min(5.6vw,8.5vh),4.8rem);line-height:1.02;letter-spacing:-.01em;color:var(--ink);margin:0 0 clamp(1rem,3vh,1.75rem);max-width:15ch;text-wrap:balance}\n.ex-hero p{font-size:clamp(1rem,calc(.5vw + 1.4vh),1.35rem);line-height:1.6;color:#3d444a;max-width:46ch;margin:0 0 clamp(1.25rem,4vh,2.25rem)}\n.ex-actions{display:flex;gap:1rem;flex-wrap:wrap}\n.ex-fig{margin:0;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.8fr);gap:1.5rem;align-items:stretch}\n.ex-fig svg{width:100%;height:auto;max-height:calc(100svh - var(--mh,80px) - 4rem);display:block}\n.ex-stats{display:flex;flex-direction:column;justify-content:space-between;padding:0 0 1.5rem;margin:0;list-style:none}\n.ex-stats li{border-top:1px solid #b9c4a6;padding-top:.75rem;margin:0}\n.ex-num{display:block;font-family:var(--d);font-weight:700;font-size:clamp(2rem,3.4vw,2.8rem);line-height:1;color:var(--gd);font-variant-numeric:tabular-nums}\n.ex-lab{display:block;font-size:.92rem;line-height:1.4;color:#4b4a44;margin-top:.35rem}\n.ex-rope,.ex-rope2{stroke-dasharray:1;animation:ex-draw 1.8s var(--ease) both}\n.ex-man{animation:ex-drop 1.8s var(--ease) both}.ex-sway{transform-origin:0 -60px;animation:ex-sway 4.2s ease-in-out 1.8s infinite alternate}.ex-legs{transform-origin:0 2px;animation:ex-push 2.6s ease-in-out 1.8s infinite alternate}\n@keyframes ex-draw{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}\n@keyframes ex-drop{from{transform:translateY(-222px)}}@keyframes ex-sway{from{transform:rotate(-1.4deg)}to{transform:rotate(1.4deg)}}@keyframes ex-push{from{transform:rotate(0)}to{transform:rotate(-4deg)}}\n@media (prefers-reduced-motion:reduce){.ex-rope,.ex-rope2,.ex-man,.ex-sway,.ex-legs{animation:none}}\n.ex-sec{padding:clamp(3.5rem,8vw,6.5rem) 1.5rem;background:#fff}\n.ex-sec-warm{background:var(--warm)}\n.ex-wrap{max-width:1180px;margin:0 auto}\n.ex-h2{font-family:var(--d);font-weight:700;font-size:clamp(2rem,3.4vw,3rem);line-height:1.08;color:var(--ink);margin:0;text-wrap:balance}\n.ex-2col{display:grid;grid-template-columns:1fr 1.3fr;gap:clamp(2rem,5vw,4.5rem);align-items:start}\n.ex-lead{font-size:1.1rem;line-height:1.65;color:var(--muted);max-width:38ch;margin:1.25rem 0 0}\n.ex-pts{list-style:none;margin:0;padding:0}\n.ex-pts li{padding:1.25rem 0;border-top:1px solid #d6d3c9;margin:0}.ex-pts li:last-child{border-bottom:1px solid #d6d3c9}\n.ex-pts b{display:block;font-family:var(--d);font-size:1.35rem;line-height:1.2;color:var(--ink);margin-bottom:.3rem}\n.ex-pts span{font-size:1rem;line-height:1.6;color:var(--muted)}\n.ex-grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:2.5rem;margin-top:3rem}\n.ex-grid3>div{border-top:2px solid var(--ink);padding-top:1rem}\n.ex-grid3 h3{font-family:var(--d);font-size:1.35rem;font-weight:700;color:var(--ink);margin:0 0 .4rem;line-height:1.2}\n.ex-grid3 p{margin:0;font-size:1rem;line-height:1.6;color:var(--muted)}\n.ex-svc-head{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;flex-wrap:wrap;padding-bottom:1.75rem;border-bottom:2px solid var(--ink)}\n.ex-svc-head p{margin:0;color:var(--muted);max-width:34ch;font-size:1.02rem;line-height:1.5}\n.ex-svcs{display:grid;grid-template-columns:repeat(2,1fr);column-gap:3rem}\n.ex-svc{display:grid;grid-template-columns:1fr auto;gap:.25rem 1rem;align-items:center;padding:1.3rem .25rem;border-bottom:1px solid var(--line);text-decoration:none;color:inherit;transition:background-color .2s var(--ease),padding .2s var(--ease)}\n.ex-svc:hover{background:var(--warm);padding-left:.9rem}\n.ex-svc:focus-visible{outline:3px solid var(--ink);outline-offset:-3px}\n.ex-svc-t{font-family:var(--d);font-weight:700;font-size:1.25rem;line-height:1.2;color:var(--ink)}\n.ex-svc-d{grid-column:1;font-size:.95rem;line-height:1.5;color:var(--muted)}\n.ex-svc svg{grid-column:2;grid-row:1/span 2;width:20px;height:20px;stroke:var(--ink);fill:none;stroke-width:2;transition:transform .2s var(--ease)}\n.ex-svc:hover svg{transform:translateX(4px)}\n.ex-band{background:var(--y);padding:clamp(3rem,6vw,4.5rem) 1.5rem}\n.ex-end{background:var(--deep);padding:clamp(3rem,6vw,4.5rem) 1.5rem}\n.ex-band-in{max-width:1180px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;gap:2rem;flex-wrap:wrap}\n.ex-band p{margin:.6rem 0 0;color:#2c3136;font-size:1.1rem;line-height:1.5}\n.ex-end .ex-h2{color:#fff}.ex-end p{margin:.6rem 0 0;color:#d7e2c6;font-size:1.1rem;line-height:1.5}\n@media (max-width:820px){.ex-hero-in,.ex-2col{grid-template-columns:1fr}.ex-fig{max-width:440px}.ex-grid3{grid-template-columns:1fr 1fr}.ex-svcs{grid-template-columns:1fr}}\n@media (max-width:560px){.ex-grid3{grid-template-columns:1fr}.ex-sec,.ex-hero,.ex-band,.ex-end{padding-left:1.25rem;padding-right:1.25rem}}\n.ex-hero{position:relative;overflow:hidden;background:#0b3d91;color:#fff;padding:0}.ex-hero-bg,.ex-hero-bg img{position:absolute;inset:0;width:100%;height:100%;display:block}.ex-hero-bg img{object-fit:cover;object-position:62% 40%}.ex-hero::after{content:\"\";position:absolute;inset:0;background:linear-gradient(90deg,rgba(6,30,70,.72) 0%,rgba(6,30,70,.45) 38%,rgba(6,30,70,0) 62%)}.ex-hero-in{position:relative;z-index:1;display:block;max-width:1280px;padding:clamp(2rem,6vh,5rem) 1.5rem}.ex-hero-txt{max-width:560px}.ex-hero h1{color:#fff;text-shadow:0 2px 18px rgba(0,0,0,.35)}.ex-hero p{color:#f1f5ff;text-shadow:0 1px 10px rgba(0,0,0,.35)}.ex-btn-w{border-color:#fff;color:#fff}.ex-btn-w:hover{background:#fff;color:var(--ink)}.ex-hero .ex-stats{flex-direction:row;flex-wrap:wrap;gap:1.25rem 2rem;padding:0;margin:clamp(1.5rem,5vh,3rem) 0 0}.ex-hero .ex-stats li{border-top:1px solid rgba(255,255,255,.55)}.ex-hero .ex-num{color:var(--y);font-size:clamp(1.8rem,3vw,2.4rem)}.ex-hero .ex-lab{color:#eaf0ff;font-size:.85rem;max-width:15ch}@media (max-width:900px){.ex-hero::after{background:linear-gradient(180deg,rgba(6,30,70,.15) 0%,rgba(6,30,70,.78) 55%,rgba(6,30,70,.9) 100%)}.ex-hero{align-items:flex-end}.ex-hero-bg img{object-position:58% 20%}.ex-hero-in{padding-top:38vh}}.ex-hero-in{display:flex;align-items:center;justify-content:space-between;gap:2rem;min-height:calc(100svh - var(--mh,80px))}.ex-wa{flex:0 0 auto;width:min(340px,100%);background:rgba(255,255,255,.94);color:var(--ink);padding:1.5rem;border-radius:4px;box-shadow:0 18px 50px rgba(6,30,70,.28);align-self:flex-end;margin-bottom:clamp(1rem,6vh,4rem)}.ex-hero .ex-wa p{color:var(--ink);text-shadow:none;margin:0}.ex-wa-k{font-family:var(--d);font-weight:700;font-size:1.5rem;line-height:1.1}.ex-wa-t{font-size:.95rem!important;line-height:1.45!important;margin:.5rem 0 1rem!important;color:#3d444a!important}.ex-btn-wa{background:#25d366;color:#052e16;gap:.6rem;width:100%;box-sizing:border-box}.ex-btn-wa:hover{background:#1ebe5b}.ex-wa-tel{display:block;text-align:center;margin-top:.8rem;font-size:.9rem;color:var(--gd);text-decoration:underline}@media (max-width:900px){.ex-hero-in{flex-direction:column;align-items:stretch;justify-content:flex-end;min-height:calc(100svh - var(--mh,80px))}.ex-wa{width:100%;box-sizing:border-box;align-self:stretch;margin:1.5rem 0 0;padding:1.1rem}}.ex-hero,.ex-hero *{box-sizing:border-box}.ex-hero{height:calc(100vh - var(--mh,80px));height:calc(100svh - var(--mh,80px));min-height:520px;max-height:none}.ex-hero-in{height:100%;min-height:0;padding:clamp(.75rem,3.5vh,2.5rem) 1.5rem}.ex-hero h1{font-size:clamp(1.9rem,min(5vw,7.5vh),4.2rem);margin-bottom:clamp(.6rem,2vh,1.25rem)}.ex-hero p{font-size:clamp(.95rem,calc(.4vw + 1.3vh),1.2rem);margin-bottom:clamp(.9rem,3vh,1.75rem)}.ex-hero .ex-stats{margin-top:clamp(1rem,3.5vh,2rem)}.ex-wa{margin-bottom:clamp(.5rem,3vh,2rem);padding:clamp(1rem,2.5vh,1.5rem)}@media (max-width:900px){.ex-hero{height:auto;min-height:calc(100svh - var(--mh,80px))}.ex-hero-in{height:auto;min-height:calc(100svh - var(--mh,80px));padding-top:34vh;padding-bottom:1.25rem}}@media (min-width:901px) and (max-height:700px){.ex-hero .ex-stats{display:none}.ex-wa-t{display:none}}@media (min-width:901px) and (max-height:560px){.ex-hero p{display:none}}.ex-hero{overflow:clip}@media (min-width:901px){.ex-wa{align-self:center;margin-bottom:0}}</style>\n<header class=\"ex-hero\" aria-label=\"Hero\"><picture class=\"ex-hero-bg\"><source media=\"(max-width:900px)\" srcset=\"/assets/foto/italfuni-edilizia-su-fune-home-1200.jpg\"><img src=\"/assets/foto/italfuni-edilizia-su-fune-home.jpg\" width=\"1500\" height=\"630\" fetchpriority=\"high\" decoding=\"async\" alt=\"Operatore Italfuni su doppia fune lungo la facciata di un palazzo\"></picture><div class=\"ex-hero-in\"><div class=\"ex-hero-txt\"><h1>Scopri il nuovo modo di fare edilizia</h1><p>Italfuni esegue lavori edili e di manutenzione su fune: pulizia vetri e grondaie, tinteggiature, impermeabilizzazioni, balconi, facciate e tetti. Sopralluogo e preventivo gratuiti e senza impegno.</p><div class=\"ex-actions\"><a class=\"ex-btn ex-btn-y\" href=\"#pricing\">Richiedi preventivo</a><a class=\"ex-btn ex-btn-w\" href=\"#servizi\">Guarda i servizi</a></div><ul class=\"ex-stats\"><li><b class=\"ex-num\">fino a &minus;40%</b><span class=\"ex-lab\">di risparmio rispetto ai metodi tradizionali</span></li><li><b class=\"ex-num\">&lt;1 ora</b><span class=\"ex-lab\">per intervenire in ogni punto</span></li><li><b class=\"ex-num\">0</b><span class=\"ex-lab\">ponteggi, 0 impalcature</span></li></ul></div><aside class=\"ex-wa\" aria-label=\"Contatto rapido\"><p class=\"ex-wa-k\">Preventivo gratuito</p><p class=\"ex-wa-t\">Scrivici due righe e una foto: ti rispondiamo subito.</p><a class=\"ex-btn ex-btn-wa\" href=\"https://wa.me/393281970254?text=Ciao%2C%20vorrei%20un%20preventivo%20gratuito%20per%20un%20lavoro%20in%20quota.\" target=\"_blank\" rel=\"noopener\" onclick=\"trackClick('edilextreme','whatsapp-hero','WhatsApp',0)\"><i class=\"fab fa-whatsapp\" aria-hidden=\"true\" style=\"font-size:1.4rem\"></i>Scrivici su WhatsApp</a><a class=\"ex-wa-tel\" href=\"tel:+393281970254\">oppure chiama +39 328 197 0254</a></aside></div></header><script>(function(){var m=document.querySelector(\".nv-header,.masthead\"),r=document.documentElement;function s(){if(m)r.style.setProperty(\"--mh\",Math.round(m.getBoundingClientRect().height)+\"px\")}s();if(window.ResizeObserver&&m)new ResizeObserver(s).observe(m);window.addEventListener(\"resize\",s);window.addEventListener(\"load\",s);if(document.fonts&&document.fonts.ready)document.fonts.ready.then(s)})()</script>"
    },
    {
        "id": "whatis",
        "nome": "Perché lavorare su fune",
        "enabled": true,
        "html": "<section class=\"ex-sec\" id=\"whatis\" aria-labelledby=\"whatis-title\"><div class=\"ex-wrap ex-2col\"><div><h2 class=\"ex-h2\" id=\"whatis-title\">Perché intervenire su fune?</h2><p class=\"ex-lead\">Al giorno d'oggi molte persone scelgono questo nuovo approccio di fare edilizia. Scopriamo insieme i motivi.</p><p class=\"exv-t\">Le persone che lavorano per te</p><ul class=\"exv\"><li><a href=\"/assets/foto/tinteggiatura-balcone-su-fune-primo-piano-andrew-arancione.jpg\" data-lb=\"home\" data-cap=\"Tinteggiatura in quota\"><img src=\"/assets/foto/t/tinteggiatura-balcone-su-fune-primo-piano-andrew-arancione.jpg\" alt=\"Tinteggiatura in quota - Italfuni\" width=\"84\" height=\"84\" loading=\"lazy\"><span>Tinteggiatura in quota</span></a></li><li><a href=\"/assets/foto/lavori-su-fune-facciata-mattoni-grondaia-andrew-arancione.jpg\" data-lb=\"home\" data-cap=\"Facciata e grondaia\"><img src=\"/assets/foto/t/lavori-su-fune-facciata-mattoni-grondaia-andrew-arancione.jpg\" alt=\"Facciata e grondaia - Italfuni\" width=\"84\" height=\"84\" loading=\"lazy\"><span>Facciata e grondaia</span></a></li><li><a href=\"/assets/foto/ristrutturazione-balconi-su-fune-cestello-andrew-arancione.jpg\" data-lb=\"home\" data-cap=\"Ristrutturazione balconi\"><img src=\"/assets/foto/t/ristrutturazione-balconi-su-fune-cestello-andrew-arancione.jpg\" alt=\"Ristrutturazione balconi - Italfuni\" width=\"84\" height=\"84\" loading=\"lazy\"><span>Ristrutturazione balconi</span></a></li><li><a href=\"/assets/foto/pulizia-grondaia-chiesa-su-fune-andrew-arancione.jpg\" data-lb=\"home\" data-cap=\"Grondaia di una chiesa\"><img src=\"/assets/foto/t/pulizia-grondaia-chiesa-su-fune-andrew-arancione.jpg\" alt=\"Grondaia di una chiesa - Italfuni\" width=\"84\" height=\"84\" loading=\"lazy\"><span>Grondaia di una chiesa</span></a></li></ul><a class=\"exv-m\" href=\"/progetti/#galleria\">Vedi tutte le foto dei lavori &rarr;</a></div><ol class=\"ex-pts\"><li><b>Problemi risolti subito</b><span>Risoluzione immediata di piccoli problemi strutturali ed estetici in posti inaccessibili.</span></li><li><b>Niente ponteggi</b><span>Non serve l'installazione o l'affitto di ponteggi o installazioni aeree.</span></li><li><b>Permessi ridotti</b><span>Di norma non servono permessi.</span></li><li><b>Burocrazia ridotta</b><span>Meno pratiche e meno attese rispetto a un cantiere con ponteggio.</span></li><li><b>Fino al 40% in meno</b><span>Abbattimento dei prezzi fino al 40%.</span></li><li><b>Interventi frazionabili</b><span>Senza impalcature si dà priorità agli interventi più urgenti, rateizzando i costi in base alla necessità del cliente.</span></li><li><b>Zero pensieri</b><span>Interventi di manutenzione programmata con la formula ZERO PENSIERI.</span></li><li><b>Nessun rischio intrusione</b><span>Eliminazione del rischio di intrusione agevolato dall'installazione dei classici ponteggi.</span></li><li><b>Meno di un'ora</b><span>Operatori altamente qualificati che intervengono in ogni punto del palazzo o di grandi strutture, risolvendo tempestivamente il problema.</span></li></ol></div></section>"
    },
    {
        "id": "stack",
        "nome": "Perché sceglierci?",
        "enabled": true,
        "html": "<section class=\"ex-sec ex-sec-warm\" id=\"stack\" aria-labelledby=\"stack-title\"><div class=\"ex-wrap\"><h2 class=\"ex-h2\" id=\"stack-title\">Perché noi?</h2><div class=\"ex-grid3\"><div><h3>Totale sicurezza</h3><p>Ogni membro del nostro team esegue corsi e aggiornamenti da istruttori di alpinismo e speleologia.</p></div><div><h3>Tutto è accessibile</h3><p>Raggiungere e operare in punti inaccessibili è il nostro pane quotidiano: per noi non esiste un punto dell'edificio inaccessibile.</p></div><div><h3>Prezzi competitivi</h3><p>Questa innovazione edilizia con radici alpinistiche permette di abbattere il prezzo: niente piattaforme o ponteggi, né costosi macchinari da affittare.</p></div><div><h3>Tempistiche</h3><p>Ci basta un punto solido dove ancorarci per operare il giorno stesso.</p></div><div><h3>Zero ponteggi</h3><p>I nostri operatori sono in grado di iniziare a lavorare dopo meno di un'ora.</p></div></div></div></section>"
    },
    {
        "id": "features",
        "nome": "Servizi",
        "enabled": true,
        "html": "<section class=\"ex-sec\" id=\"servizi\" aria-labelledby=\"features-title\"><div class=\"ex-wrap\"><div class=\"ex-svc-head\"><h2 class=\"ex-h2\" id=\"features-title\">Servizi</h2><p>Dodici interventi, un solo metodo: accesso su corda, nessun ponteggio.</p></div><div class=\"ex-svcs\"><a class=\"ex-svc\" href=\"https://cialdecompatibili-netizen.github.io/edilextreme4/servizi/impermeabilizzazione-su-fune/\"><span class=\"ex-svc-t\">Impermeabilizzazione su fune</span><span class=\"ex-svc-d\">Terrazzi, tetti e lastre protetti dall'acqua e dagli agenti atmosferici.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"https://cialdecompatibili-netizen.github.io/edilextreme4/servizi/manutenzione-e-sostituzione-grondaie/\"><span class=\"ex-svc-t\">Riparazione e pulizia grondaie</span><span class=\"ex-svc-d\">Pulizia e sostituzione di ogni tipo di componente.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"https://cialdecompatibili-netizen.github.io/edilextreme4/servizi/montaggio-isolanti/\"><span class=\"ex-svc-t\">Montaggio isolanti</span><span class=\"ex-svc-d\">Isolamento termico eseguito in quota senza ponteggi.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"https://cialdecompatibili-netizen.github.io/edilextreme4/servizi/manutenzione-e-installazione-canne-fumarie/\"><span class=\"ex-svc-t\">Canne fumarie</span><span class=\"ex-svc-d\">Pulizia, manutenzione e installazione anche in copertura.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"https://cialdecompatibili-netizen.github.io/edilextreme4/servizi/installazione-e-manutenzione-dissuasori-volatili/\"><span class=\"ex-svc-t\">Dissuasori per piccioni</span><span class=\"ex-svc-d\">Installazione e manutenzione di sistemi anti-volatili.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"https://cialdecompatibili-netizen.github.io/edilextreme4/servizi/montaggio-sistemi-di-sicurezza-su-fune/\"><span class=\"ex-svc-t\">Sistemi di sicurezza su fune</span><span class=\"ex-svc-d\">Montaggio linee vita e ancoraggi certificati.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"https://cialdecompatibili-netizen.github.io/edilextreme4/servizi/messa-in-sicurezza/\"><span class=\"ex-svc-t\">Messa in sicurezza</span><span class=\"ex-svc-d\">Rimozione urgente di materiale pericolante su fune.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"https://cialdecompatibili-netizen.github.io/edilextreme4/servizi/potatura-alberi/\"><span class=\"ex-svc-t\">Potatura alberi</span><span class=\"ex-svc-d\">Interventi su piante alte e difficili da raggiungere.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"https://cialdecompatibili-netizen.github.io/edilextreme4/servizi/pulizia-componenti-su-fune/\"><span class=\"ex-svc-t\">Pulizia componenti su fune</span><span class=\"ex-svc-d\">Pulizia mirata di elementi in quota su ogni edificio.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"https://cialdecompatibili-netizen.github.io/edilextreme4/servizi/pulizia-pannelli-fotovoltaici/\"><span class=\"ex-svc-t\">Pulizia pannelli fotovoltaici</span><span class=\"ex-svc-d\">Manutenzione per mantenere alta l'efficienza dell'impianto.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"https://cialdecompatibili-netizen.github.io/edilextreme4/servizi/pulizia-vetri/\"><span class=\"ex-svc-t\">Pulizia vetri in altezza</span><span class=\"ex-svc-d\">Vetrate di palazzi e grattacieli, anche nei casi piu complessi.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"https://cialdecompatibili-netizen.github.io/edilextreme4/servizi/ristrutturazioni-balconi-e-facciate/\"><span class=\"ex-svc-t\">Balconi, facciate e tetto</span><span class=\"ex-svc-d\">Ristrutturazione e ripristino estetico e strutturale.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a></div></div></section>"
